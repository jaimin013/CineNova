# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Only openssl needed for Prisma
RUN apk add --no-cache openssl

COPY package*.json ./
# Using npm install instead of ci to handle the local lockfile changes
RUN npm install

COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Build TypeScript
RUN npm run build

# Stage 2: Production Dependencies (Standalone-like pruning)
FROM node:22-alpine AS deps

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

# Prune unnecessary files from node_modules (docs, tests, etc.)
RUN apk add --no-cache curl \
    && curl -sf https://gobinaries.com/tj/node-prune | sh \
    && node-prune \
    && apk del curl

# Stage 3: Runtime
FROM node:22-alpine AS runner

WORKDIR /app

# Only the essentials for Prisma runtime
RUN apk add --no-cache openssl libgcc libstdc++

# Create logs directory and set permissions
RUN mkdir -p logs && chown -R node:node logs

# Copy pruned production dependencies
COPY --from=deps /app/node_modules ./node_modules
# Copy built assets
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
# Copy the prisma binary from node_modules for migration tasks
COPY --from=builder /app/node_modules/.bin/prisma /usr/local/bin/prisma
# Copy the actual prisma client generated in the builder stage
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Set production environment
ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

# Non-root user for security
USER node

CMD ["node", "dist/index.js"]
