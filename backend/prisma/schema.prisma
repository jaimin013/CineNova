generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  password     String // Hashed with bcrypt
  refreshToken String? // Stored for this device/session
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  password     String // Hashed with bcrypt
  role         String   @default("admin") // "admin" or "superadmin"
  refreshToken String? // Stored for this device/session
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Content {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  type        String // "movie" or "series"
  posterUrl   String // URL to poster image
  rating      Float    @default(0.0)
  genre       String // comma-separated genres: "Action,Drama,Sci-Fi"
  releaseYear Int?
  duration    Int? // duration in minutes
  section     String // maintained for backward compatibility or direct access
  platform    String? // "netflix", "jiohotstar", "prime", null for general
  backdropUrl String? // Hero section backdrop image
  featured    Boolean  @default(false) // For hero section
  videoUrl    String? // YouTube video URL for featured section (optional)
  casts       String? // JSON string of cast array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([section])
  @@index([platform])
  @@index([featured])
}

model Section {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Platform {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
